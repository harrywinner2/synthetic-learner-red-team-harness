# Copy to .env and fill in. .env is gitignored and must NEVER be committed.
# This key powers the *running app's* AI calls (synthetic learners, tutor,
# evaluators). It is read server-side only; the browser never sees it.

# Required for live runs + demo TTS. Leave blank to run in deterministic mock
# mode (the app still works end-to-end; cached fixtures + a scripted simulator).
OPENAI_API_KEY=

# Model used for all runtime LLM calls. gpt-4o-mini is cheap and plenty here.
OPENAI_MODEL=gpt-4o-mini

# Optional independent-judge model (human-agreement proxy). Defaults to a
# different setting than the primary evaluator if set.
JUDGE_MODEL=gpt-4o-mini

# Persistence. Defaults to a local SQLite file. Set a Postgres URL on Railway
# (Railway injects DATABASE_URL automatically when you add a Postgres plugin).
DATABASE_URL=sqlite:///./harness.db

# Cap live-run cost: max personas + max dialogue turns per skill.
MAX_LIVE_PERSONAS=6
MAX_TURNS_PER_SKILL=6
